# ==============================================================================
# CampusPulse - Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local for local development.
# Never commit real secrets or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=CampusPulse
APP_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. Local Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# For special characters in passwords (e.g. '@'), use URL encoding (%40).
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/campuspulse?schema=public

# ------------------------------------------------------------------------------
# 3. Authentication & Sessions
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens and encryption.
# Generate a secure 32+ character random string (e.g. `openssl rand -base64 32`).
AUTH_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS
AUTH_URL=http://localhost:3000

# Optional OAuth Provider Credentials (uncomment when enabling Google SSO)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Development-only Mock Authentication Mode (Set to false or unset in production)
DEV_AUTH_ENABLED=true

# ------------------------------------------------------------------------------
# 4. File Storage Configuration
# ------------------------------------------------------------------------------
# Supported providers: "local" (default) or "s3"
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./.local-storage/uploads
MAX_UPLOAD_SIZE_MB=5

# Optional S3-compatible cloud storage (AWS / Cloudflare R2 / MinIO)
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# ------------------------------------------------------------------------------
# 5. AI Poster Extraction Configuration
# ------------------------------------------------------------------------------
# Supported providers: "mock" (default, deterministic), "gemini", "openai"
AI_PROVIDER=mock
# AI_API_KEY=
# AI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 6. Notifications & Email (Optional)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=notifications@campuspulse.srmist.edu.in
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# 7. Logging & Diagnostics
# ------------------------------------------------------------------------------
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 8. Security & Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
